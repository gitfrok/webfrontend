---
// SecurityFindings renders the unified security dashboard's result surface
// (T-0023, SPEC-0026): one consolidated view across every scanner class with
// progressive disclosure — a compact row per finding, expanded detail on
// demand — instead of a per-scanner tab set (ADR-0015, SPEC-0026 AC9).
//
// Presentational only. Counts, facets, membership and order arrive from the
// backend under the caller's authorization; this component renders them
// verbatim and infers nothing about permissions. The empty state is one
// shape for "no matches" and "nothing you may read" alike, because that is
// what the backend sends (SPEC-0026 AC6).
import type { SecurityFilters, SecurityFindingView, SecuritySummary } from '../lib/bff';
import SecurityTriage from './SecurityTriage';

interface Props {
  findings: SecurityFindingView[];
  summary: SecuritySummary;
  filters: SecurityFilters;
  nextPageToken: string;
}

const { findings, summary, filters, nextPageToken } = Astro.props;

// Facet dimensions the contract names as filters; a dimension outside this
// set renders as text only, never as a guessed link.
const facetFilterKeys: Record<string, keyof SecurityFilters> = {
  severity: 'severity',
  scanner_class: 'scanner_class',
  lifecycle: 'lifecycle',
  owning_team: 'owning_team',
};

const facetTitles: Record<string, string> = {
  severity: 'Severity',
  scanner_class: 'Scanner class',
  lifecycle: 'Lifecycle',
  owning_team: 'Owning team',
};

// queryOf renders the current filters as a query string, optionally with one
// filter replaced or cleared — how a facet value or a select toggles a filter.
function queryOf(override?: { key: keyof SecurityFilters; value: string }): string {
  const params = new URLSearchParams();
  const merged: SecurityFilters = { ...filters };
  if (override) {
    if (override.value === '' || merged[override.key] === override.value) {
      delete merged[override.key];
    } else {
      merged[override.key] = override.value;
    }
  }
  if (merged.repository) params.set('repository', merged.repository);
  if (merged.scanner_class) params.set('scanner_class', merged.scanner_class);
  if (merged.severity) params.set('severity', merged.severity);
  if (merged.lifecycle) params.set('lifecycle', merged.lifecycle);
  if (merged.min_age_days) params.set('min_age_days', String(merged.min_age_days));
  if (merged.max_age_days) params.set('max_age_days', String(merged.max_age_days));
  if (merged.owning_team) params.set('owning_team', merged.owning_team);
  const query = params.toString();
  return query ? `/security?${query}` : '/security';
}

const hasFilters = Boolean(
  filters.repository ||
    filters.scanner_class ||
    filters.severity ||
    filters.lifecycle ||
    filters.min_age_days ||
    filters.max_age_days ||
    filters.owning_team,
);

// Severity comes from the ONE status vocabulary (SPEC-0047 AC6/AC7): glyph,
// word and rank travel together, so severity survives grayscale and a screen
// reader. The old table here was a red-to-green heat ramp — the pairing the
// brand's intensity rule forbids.
import { describeStatus, type StatusKey } from '../lib/status';

const scannerClasses = ['SAST', 'DEPENDENCY', 'SECRETS', 'CONTAINER', 'DAST'];
const severities = ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'];
const lifecycles = ['OPEN', 'RESOLVED'];

// nextHref carries the active filters onto the next cursor page; the cursor
// itself is opaque and tenant-bound, so it travels as given.
function nextHref(token: string): string {
  const params = new URLSearchParams();
  if (filters.repository) params.set('repository', filters.repository);
  if (filters.scanner_class) params.set('scanner_class', filters.scanner_class);
  if (filters.severity) params.set('severity', filters.severity);
  if (filters.lifecycle) params.set('lifecycle', filters.lifecycle);
  if (filters.min_age_days) params.set('min_age_days', String(filters.min_age_days));
  if (filters.max_age_days) params.set('max_age_days', String(filters.max_age_days));
  if (filters.owning_team) params.set('owning_team', filters.owning_team);
  params.set('page_token', token);
  return `/security?${params.toString()}`;
}
---

<section aria-label="Security dashboard">
  <div style={{ display: 'flex', flexWrap: 'wrap', gap: '24px', alignItems: 'flex-start', margin: '16px 0' }}>
    <div
      style={{
        padding: '10px 16px',
        border: '1px solid var(--gf-line)',
        borderRadius: '6px',
        background: 'var(--gf-soft)',
        minWidth: '120px',
      }}
    >
      <div style={{ fontSize: '24px', fontWeight: 600, lineHeight: 1.2 }}>{summary.total_count}</div>
      <div style={{ fontSize: '12px', color: 'var(--gf-ink-muted)' }}>findings</div>
    </div>

    {summary.facets.map((facet) => (
      <div style={{ minWidth: '160px' }}>
        <div style={{ fontSize: '12px', fontWeight: 600, color: 'var(--gf-ink-muted)', textTransform: 'uppercase', letterSpacing: '0.4px' }}>
          {facetTitles[facet.dimension] ?? facet.dimension}
        </div>
        <ul style={{ listStyle: 'none', margin: '4px 0 0', padding: '0px' }}>
          {facet.values.map((value) => {
            const filterKey = facetFilterKeys[facet.dimension];
            const active = filterKey !== undefined && filters[filterKey] === value.value;
            return (
              <li style={{ fontSize: '13px', padding: '1px 0' }}>
                {filterKey !== undefined ? (
                  <a
                    href={queryOf({ key: filterKey, value: value.value })}
                    aria-pressed={active ? 'true' : 'false'}
                    style={{
                      color: active ? 'var(--gf-ink)' : 'var(--gf-action-ink)',
                      textDecoration: 'none',
                      fontWeight: active ? 600 : 400,
                    }}
                  >
                    {value.value} <span style={{ color: 'var(--gf-ink-muted)' }}>({value.count})</span>
                  </a>
                ) : (
                  <span>
                    {value.value} <span style={{ color: 'var(--gf-ink-muted)' }}>({value.count})</span>
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>

  <form method="get" action="/security" aria-label="Filter findings" style={{ display: 'flex', flexWrap: 'wrap', gap: '12px', alignItems: 'flex-end', padding: '12px 0', borderTop: '1px solid var(--gf-line)', borderBottom: '1px solid var(--gf-line)' }}>
    <label style={{ fontSize: '12px', color: 'var(--gf-ink-muted)', display: 'flex', flexDirection: 'column', gap: '4px' }}>
      Repository
      <input name="repository" value={filters.repository ?? ''} style={{ padding: '4px 8px', fontSize: '13px', border: '1px solid var(--gf-line)', borderRadius: '6px', minWidth: '160px' }} />
    </label>
    <label style={{ fontSize: '12px', color: 'var(--gf-ink-muted)', display: 'flex', flexDirection: 'column', gap: '4px' }}>
      Scanner class
      <select name="scanner_class" style={{ padding: '4px 8px', fontSize: '13px', border: '1px solid var(--gf-line)', borderRadius: '6px' }}>
        <option value="">Any</option>
        {scannerClasses.map((option) => (
          <option value={option} selected={filters.scanner_class === option}>{option}</option>
        ))}
      </select>
    </label>
    <label style={{ fontSize: '12px', color: 'var(--gf-ink-muted)', display: 'flex', flexDirection: 'column', gap: '4px' }}>
      Severity
      <select name="severity" style={{ padding: '4px 8px', fontSize: '13px', border: '1px solid var(--gf-line)', borderRadius: '6px' }}>
        <option value="">Any</option>
        {severities.map((option) => (
          <option value={option} selected={filters.severity === option}>{option}</option>
        ))}
      </select>
    </label>
    <label style={{ fontSize: '12px', color: 'var(--gf-ink-muted)', display: 'flex', flexDirection: 'column', gap: '4px' }}>
      Lifecycle
      <select name="lifecycle" style={{ padding: '4px 8px', fontSize: '13px', border: '1px solid var(--gf-line)', borderRadius: '6px' }}>
        <option value="">Any</option>
        {lifecycles.map((option) => (
          <option value={option} selected={filters.lifecycle === option}>{option}</option>
        ))}
      </select>
    </label>
    <label style={{ fontSize: '12px', color: 'var(--gf-ink-muted)', display: 'flex', flexDirection: 'column', gap: '4px' }}>
      Min age (days)
      <input name="min_age_days" type="number" min="0" value={filters.min_age_days ? String(filters.min_age_days) : ''} style={{ padding: '4px 8px', fontSize: '13px', border: '1px solid var(--gf-line)', borderRadius: '6px', width: '90px' }} />
    </label>
    <label style={{ fontSize: '12px', color: 'var(--gf-ink-muted)', display: 'flex', flexDirection: 'column', gap: '4px' }}>
      Max age (days)
      <input name="max_age_days" type="number" min="0" value={filters.max_age_days ? String(filters.max_age_days) : ''} style={{ padding: '4px 8px', fontSize: '13px', border: '1px solid var(--gf-line)', borderRadius: '6px', width: '90px' }} />
    </label>
    <label style={{ fontSize: '12px', color: 'var(--gf-ink-muted)', display: 'flex', flexDirection: 'column', gap: '4px' }}>
      Owning team
      <input name="owning_team" value={filters.owning_team ?? ''} style={{ padding: '4px 8px', fontSize: '13px', border: '1px solid var(--gf-line)', borderRadius: '6px', minWidth: '120px' }} />
    </label>
    <button type="submit" style={{ padding: '5px 16px', fontSize: '13px', border: '1px solid var(--gf-line)', borderRadius: '6px', background: 'var(--gf-success)', color: 'var(--gf-surface)', cursor: 'pointer' }}>
      Apply filters
    </button>
    {hasFilters && (
      <a href="/security" style={{ fontSize: '13px', color: 'var(--gf-action-ink)', textDecoration: 'none', padding: '5px 0' }}>
        Clear filters
      </a>
    )}
  </form>

  {findings.length === 0 ? (
    <p style={{ padding: '24px 0', color: 'var(--gf-ink-muted)', fontSize: '14px' }}>
      No findings to show.
    </p>
  ) : (
    <>
      <table style={{ width: '100%', borderCollapse: 'collapse', marginTop: '16px' }}>
        <thead>
          <tr style={{ textAlign: 'left', borderBottom: '1px solid var(--gf-line)' }}>
            <th style={{ padding: '8px 12px', fontSize: '12px', color: 'var(--gf-ink-muted)' }}>Finding</th>
            <th style={{ padding: '8px 12px', fontSize: '12px', color: 'var(--gf-ink-muted)' }}>Repository</th>
            <th style={{ padding: '8px 12px', fontSize: '12px', color: 'var(--gf-ink-muted)' }}>Class</th>
            <th style={{ padding: '8px 12px', fontSize: '12px', color: 'var(--gf-ink-muted)' }}>Severity</th>
            <th style={{ padding: '8px 12px', fontSize: '12px', color: 'var(--gf-ink-muted)' }}>Lifecycle</th>
          </tr>
        </thead>
        <tbody>
          {findings.map((finding) => {
            const badge = describeStatus(finding.severity as StatusKey);
            return (
              <tr>
                <td colspan="5" style={{ padding: '0px', borderBottom: '1px solid var(--gf-line)' }}>
                  <details>
                    <summary style={{ cursor: 'pointer', padding: '10px 12px', listStyle: 'none', display: 'grid', gridTemplateColumns: '2fr 1fr 1fr 1fr 1fr', gap: '8px', alignItems: 'center' }}>
                      <span style={{ fontSize: '13px' }}>
                        <strong style={{ fontWeight: 600 }}>{finding.rule_id || finding.finding_id}</strong>
                        {finding.artifact_path && (
                          <span style={{ color: 'var(--gf-ink-muted)' }}> · {finding.artifact_path}</span>
                        )}
                      </span>
                      <span style={{ fontSize: '13px', color: 'var(--gf-ink-muted)' }}>{finding.repository_id}</span>
                      <span style={{ fontSize: '13px', color: 'var(--gf-ink-muted)' }}>{finding.scanner_class}</span>
                      <span>
                        <span class:list={['gf-status', badge.tone]} style={{ fontSize: '12px' }}>
                          {badge.descriptor.label} {badge.descriptor.rank}/4
                        </span>
                      </span>
                      {/* Lifecycle was colour-only; it now carries its glyph
                          and word like every other status (AC6). */}
                      <span class:list={['gf-status', describeStatus(finding.lifecycle as StatusKey).tone]} style={{ fontSize: '12px' }}>
                        {describeStatus(finding.lifecycle as StatusKey).descriptor.label}
                      </span>
                    </summary>
                    <div style={{ padding: '0 12px 12px 28px' }}>
                      <dl style={{ display: 'grid', gridTemplateColumns: '140px 1fr', gap: '2px 12px', margin: '0px', fontSize: '13px' }}>
                        <dt style={{ color: 'var(--gf-ink-muted)' }}>Finding ID</dt>
                        <dd style={{ margin: '0px' }}>{finding.finding_id}</dd>
                        {finding.component && (
                          <>
                            <dt style={{ color: 'var(--gf-ink-muted)' }}>Component</dt>
                            <dd style={{ margin: '0px' }}>{finding.component}{finding.component_version ? `@${finding.component_version}` : ''}</dd>
                          </>
                        )}
                        {finding.enclosing_content && (
                          <>
                            <dt style={{ color: 'var(--gf-ink-muted)' }}>Enclosing content</dt>
                            <dd style={{ margin: '0px' }}>{finding.enclosing_content}</dd>
                          </>
                        )}
                        <dt style={{ color: 'var(--gf-ink-muted)' }}>Tool</dt>
                        <dd style={{ margin: '0px' }}>{finding.tool_name}{finding.tool_version ? ` ${finding.tool_version}` : ''}</dd>
                        <dt style={{ color: 'var(--gf-ink-muted)' }}>First seen</dt>
                        <dd style={{ margin: '0px' }}>scan {finding.first_seen_scan_id}</dd>
                        <dt style={{ color: 'var(--gf-ink-muted)' }}>Last seen</dt>
                        <dd style={{ margin: '0px' }}>scan {finding.last_seen_scan_id}</dd>
                      </dl>
                      <SecurityTriage client:load findingID={finding.finding_id} repositoryID={finding.repository_id} />
                    </div>
                  </details>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div style={{ padding: '12px 0' }}>
        {nextPageToken && (
          <a href={nextHref(nextPageToken)} style={{ fontSize: '13px', color: 'var(--gf-action-ink)', textDecoration: 'none' }}>
            Next page →
          </a>
        )}
      </div>
    </>
  )}
</section>
