---
// Imported review history, rendered so it can never be mistaken for history
// this platform witnessed (SPEC-0011 AC23, ADR-0029, ADR-0015).
//
// Every rendering decision here comes from src/lib/provenance.ts, which is unit
// tested on its own. This file only draws what those rules return: an imported
// section that is visually and textually separated from first-party review, an
// imported approval that states it satisfies no merge policy, a foreign handle
// that is never a link to a platform user, and an approximate anchor that says
// it is approximate.
import {
  anchorNote,
  approvalPresentation,
  declaredActorLabel,
  declaredAtLabel,
  originLabel,
  type ImportedMergeRequestView,
} from '../lib/provenance';

interface Props {
  records: ImportedMergeRequestView[];
}

const { records } = Astro.props;

// The unverified treatment. It is one set of tokens rather than per-element
// styling so an imported record cannot accidentally inherit the first-party look.
const unverified = {
  border: '1px dashed var(--gf-warn-ink)',
  background: 'var(--gf-diff-del-bg)',
  color: 'var(--gf-warn-ink)',
};
---

{records.length > 0 && (
  <section
    aria-labelledby="imported-history-heading"
    style={{ margin: '24px 0', padding: '16px', ...unverified, borderRadius: '6px' }}
  >
    <h2 id="imported-history-heading" style={{ fontSize: '16px', margin: '0px' }}>
      Imported history — not verified by this platform
    </h2>
    <p style={{ margin: '8px 0 0', fontSize: '13px' }}>
      These records were declared by the source system during a repository import. This platform did
      not witness them: the names, dates and approvals below are as the source declared them, they
      are not platform identities, and no approval here satisfies a merge policy.
    </p>

    {records.map((record) => (
      <article style={{ marginTop: '16px', paddingTop: '12px', borderTop: '1px solid var(--gf-warn)' }}>
        <h3 style={{ fontSize: '14px', margin: '0px' }}>
          <span style={{ fontWeight: 400, fontSize: '12px', marginRight: '8px', padding: '1px 6px', border: '1px solid var(--gf-warn-ink)', borderRadius: '10px' }}>
            {originLabel(record.provenance)}
          </span>
          {record.title}
        </h3>
        <p style={{ margin: '6px 0 0', fontSize: '13px' }}>
          {record.state} · {record.source_ref} → {record.target_ref} · declared by{' '}
          {declaredActorLabel(record.provenance, record.declared_creator)}
        </p>

        {record.threads?.map((thread) => (
          <div style={{ marginTop: '12px' }}>
            <p style={{ margin: '0px', fontSize: '12px' }}>{thread.path || 'merge request'}</p>
            {anchorNote(thread) && (
              <p style={{ margin: '4px 0 0', fontSize: '12px', fontStyle: 'italic' }}>{anchorNote(thread)}</p>
            )}
            {thread.comments?.map((comment) => (
              <blockquote style={{ margin: '8px 0 0', paddingLeft: '12px', borderLeft: '3px solid var(--gf-warn)' }}>
                <p style={{ margin: '0px', fontSize: '12px' }}>
                  {declaredActorLabel(comment.provenance, comment.declared_actor)} ·{' '}
                  {declaredAtLabel(comment.declared_at ?? comment.provenance?.declared_at)}
                </p>
                <p style={{ margin: '4px 0 0', fontSize: '13px' }}>{comment.body}</p>
              </blockquote>
            ))}
          </div>
        ))}

        {record.approvals?.length > 0 && (
          <ul style={{ margin: '12px 0 0', padding: '0px', listStyle: 'none' }}>
            {record.approvals.map((approval) => (
              <li style={{ fontSize: '12px', marginTop: '4px' }}>{approvalPresentation(approval).label}</li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </section>
)}
