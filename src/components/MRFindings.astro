---
// MRFindings renders the findings a merge request introduced (T-0024,
// SPEC-0028): one section on the merge request page with the attribution
// summary, and one row per finding showing its severity, its location at the
// MR's head revision, its attribution status and its triage state.
//
// Presentational only. Attribution, triage, membership, order and counts
// arrive from the backend under the caller's authorization and are rendered
// verbatim; this component infers nothing about permissions. A triaged
// finding renders in its triaged state rather than as new (SPEC-0028 AC5),
// and a failed, timed-out, missing or not-yet-run scan renders as
// UNAVAILABLE with its reason — never as "no findings" (SPEC-0028 AC7).
import type { AttributionSummary, MRFindingView } from '../lib/bff';

interface Props {
  findings: MRFindingView[];
  summary: AttributionSummary;
  // The link to this MR's diff, already carrying merge_request_id: rows deep
  // link into their inline placement there with the finding's identity as
  // the anchor, so a later push that shifts the line re-resolves the
  // placement without breaking the link (SPEC-0024 identity stability).
  diffHref: string;
  nextPageToken: string;
}

const { findings, summary, diffHref, nextPageToken } = Astro.props;

const unavailable = summary.status === 'UNAVAILABLE';
// "No findings" is a statement only the computed summary may make: an
// UNAVAILABLE summary with an empty list is still UNAVAILABLE (AC7).
const computedEmpty = !unavailable && findings.length === 0;

// The honest reasons the contract names for an unavailable comparison, as a
// reviewer reads them. The raw token travels beside it as the machine fact.
const unavailableReasons: Record<string, string> = {
  BASE_NOT_SCANNED: 'the target branch has not been scanned at the merge base',
  HEAD_SCAN_FAILED: 'the scan of this merge request’s head revision failed',
  HEAD_SCAN_TIMED_OUT: 'the scan of this merge request’s head revision timed out',
  HEAD_SCAN_NOT_RUN: 'no scan of this merge request’s head revision has run yet',
  NO_MERGE_BASE: 'the source and target revisions share no merge base',
};

// One vocabulary for severity, shared with the dashboard (SPEC-0047 AC6).
import { describeStatus, type StatusKey } from '../lib/status';

// Triage state as the reviewer reads it. Absence of a triage record is the
// only thing that renders as awaiting triage — a recorded decision, whatever
// it is, renders as that decision (SPEC-0028 AC5).
const triageLabels: Record<string, string> = {
  ACCEPT: 'Accepted',
  FALSE_POSITIVE: 'False positive',
  FIX: 'Fix',
  DEFER: 'Deferred',
};

const attributionLabels: Record<string, { label: string; color: string; background: string }> = {
  ATTRIBUTED: { label: 'Introduced by this MR', color: 'var(--gf-danger-ink)', background: 'var(--gf-diff-del-bg)' },
  PRE_EXISTING: { label: 'Pre-existing', color: 'var(--gf-ink-muted)', background: 'var(--gf-line)' },
  UNAVAILABLE: { label: 'Attribution unavailable', color: 'var(--gf-warn-ink)', background: 'var(--gf-diff-del-bg)' },
};

const severityCounts = [
  { label: 'critical', count: summary.attributed_critical, style: describeStatus('CRITICAL') },
  { label: 'high', count: summary.attributed_high, style: describeStatus('HIGH') },
  { label: 'medium', count: summary.attributed_medium, style: describeStatus('MEDIUM') },
  { label: 'low', count: summary.attributed_low, style: describeStatus('LOW') },
].filter((entry) => entry.count > 0);

function deepLink(findingID: string): string {
  const separator = diffHref.includes('#') ? '&' : '#';
  return `${diffHref}${separator}finding-${encodeURIComponent(findingID)}`;
}
---

<section
  aria-label="Security findings introduced by this merge request"
  style={{ margin: 'var(--gf-space-6) 0', border: '1px solid var(--gf-line)', borderRadius: 'var(--gf-radius-control)', overflow: 'hidden' }}
>
  <header
    style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: 'var(--gf-space-2)', padding: 'var(--gf-space-2) var(--gf-space-4)', background: 'var(--gf-soft)', borderBottom: '1px solid var(--gf-line)' }}
  >
    <h2 style={{ fontSize: 'var(--gf-text-base)', margin: '0', marginRight: 'auto' }}>Security findings</h2>
    {severityCounts.map((entry) => (
      <span class:list={['gf-status', entry.style.tone]} style={{ fontSize: 'var(--gf-text-xs)' }}>
        {entry.count} {entry.label}
      </span>
    ))}
    {summary.stale && (
      <span style={{ fontSize: 'var(--gf-text-xs)', color: 'var(--gf-warn-ink)', fontStyle: 'italic' }}>
        attribution stale — being recomputed
      </span>
    )}
  </header>

  {unavailable && (
    <div
      role="status"
      style={{ margin: 'var(--gf-space-4)', padding: 'var(--gf-space-3) var(--gf-space-4)', border: '1px solid var(--gf-warn)', borderRadius: 'var(--gf-radius-control)', background: 'var(--gf-diff-del-bg)' }}
    >
      <p style={{ margin: '0', fontWeight: 600, fontSize: 'var(--gf-text-base)' }}>
        Attribution unavailable
        <code style={{ marginLeft: 'var(--gf-space-2)', fontSize: 'var(--gf-text-xs)', fontWeight: 400, color: 'var(--gf-ink-muted)', background: 'var(--gf-surface)', padding: 'var(--gf-space-1) var(--gf-space-1)', borderRadius: 'var(--gf-radius-control)' }}>
          UNAVAILABLE
        </code>
      </p>
      <p style={{ margin: 'var(--gf-space-1) 0 0', fontSize: 'var(--gf-text-sm)', color: 'var(--gf-warn-ink)' }}>
        {summary.unavailable_reason
          ? unavailableReasons[summary.unavailable_reason] ?? 'the comparison cannot be computed'
          : 'the comparison cannot be computed'}
        {summary.unavailable_reason && (
          <code style={{ marginLeft: 'var(--gf-space-1)', fontSize: 'var(--gf-text-xs)', color: 'var(--gf-ink-muted)', background: 'var(--gf-surface)', padding: 'var(--gf-space-1) var(--gf-space-1)', borderRadius: 'var(--gf-radius-control)' }}>
            {summary.unavailable_reason}
          </code>
        )}
        {' '}The findings this merge request introduces cannot be stated until the comparison can be
        computed; this is not a statement that it introduces none.
      </p>
    </div>
  )}

  {!unavailable && (
    <p style={{ margin: 'var(--gf-space-3) var(--gf-space-4) 0', fontSize: 'var(--gf-text-xs)', color: 'var(--gf-ink-muted)' }}>
      Compared head <code>{summary.head_revision.slice(0, 8)}</code> against merge base{' '}
      <code>{summary.merge_base_revision.slice(0, 8)}</code>.
    </p>
  )}

  {computedEmpty && (
    <p style={{ margin: 'var(--gf-space-4)', fontSize: 'var(--gf-text-base)', color: 'var(--gf-ink-muted)' }}>No findings introduced by this merge request.</p>
  )}

  {findings.length > 0 && (
    <ul style={{ listStyle: 'none', margin: '0', padding: '0' }}>
      {findings.map((view) => {
        const severityStyle = describeStatus(view.finding.severity as StatusKey);
        const attribution = attributionLabels[view.attribution] ?? attributionLabels.UNAVAILABLE;
        const triageLabel = view.triage ? triageLabels[view.triage.state] ?? view.triage.state : '';
        return (
          <li
            id={`finding-${view.finding.finding_id}`}
            style={{ padding: 'var(--gf-space-3) var(--gf-space-4)', borderBottom: '1px solid var(--gf-line)', fontSize: 'var(--gf-text-sm)' }}
          >
            <div style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: 'var(--gf-space-2)' }}>
              {/* Glyph, word and rank — the severity reads with the tint
                  removed entirely (SPEC-0047 AC6). */}
              <span class:list={['gf-status', severityStyle.tone]} style={{ fontSize: 'var(--gf-text-xs)' }}>
                {severityStyle.descriptor.label} {severityStyle.descriptor.rank}/4
              </span>
              <span style={{ fontWeight: 600 }}>{view.finding.rule_id}</span>
              <span style={{ color: 'var(--gf-ink-muted)' }}>{view.finding.scanner_class}</span>
              <span
                style={{
                  fontSize: 'var(--gf-text-xs)',
                  padding: 'var(--gf-space-1) var(--gf-space-2)',
                  borderRadius: 'var(--gf-radius-pill)',
                  color: attribution.color,
                  background: attribution.background,
                }}
              >
                {attribution.label}
              </span>
              <span
                style={{
                  marginLeft: 'auto',
                  fontSize: 'var(--gf-text-xs)',
                  fontWeight: view.triage ? 600 : 400,
                  color: view.triage ? 'var(--gf-info-ink)' : 'var(--gf-ink-muted)',
                }}
              >
                {triageLabel || 'Awaiting triage'}
              </span>
            </div>
            <p style={{ margin: 'var(--gf-space-1) 0 0', color: 'var(--gf-ink-muted)' }}>
              <code style={{ fontSize: 'var(--gf-text-xs)' }}>{view.head_location.artifact_path}</code>
              {view.head_location.enclosing_content && (
                <>
                  {' '}· <code style={{ fontSize: 'var(--gf-text-xs)' }}>{view.head_location.enclosing_content}</code>
                </>
              )}
            </p>
            {view.triage && view.triage.justification && (
              <p style={{ margin: 'var(--gf-space-1) 0 0', fontSize: 'var(--gf-text-xs)', color: 'var(--gf-ink-muted)', fontStyle: 'italic' }}>
                Triage ({triageLabel}): “{view.triage.justification}”
              </p>
            )}
            <a href={deepLink(view.finding.finding_id)} style={{ color: 'var(--gf-action-ink)', textDecoration: 'none', fontSize: 'var(--gf-text-xs)' }}>
              View in diff →
            </a>
          </li>
        );
      })}
    </ul>
  )}

  {nextPageToken && (
    <p style={{ margin: '0', padding: 'var(--gf-space-3) var(--gf-space-4)', borderTop: '1px solid var(--gf-line)', fontSize: 'var(--gf-text-sm)' }}>
      <a
        href={`?mr_findings_page_token=${encodeURIComponent(nextPageToken)}`}
        style={{ color: 'var(--gf-action-ink)', textDecoration: 'none' }}
      >
        Next page of findings
      </a>
    </p>
  )}
</section>
