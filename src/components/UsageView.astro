---
// UsageView renders the fair-use usage view (T-0034, SPEC-0041). Presentational
// only: every number arrives from the control plane, which is the metering
// authority (ADR-0061); this component renders what it receives and infers,
// computes and adjusts nothing.
//
// The two commitments this markup encodes:
//  - a DEFERRED dimension and a telemetry gap render as a visible gap with a
//    reason — never as a number, never as zero (SPEC-0041 AC2, AC3). The rows
//    carry no value field to render, so a zero here would be fabricated.
//  - a divergence renders as a health finding carrying BOTH numbers; the
//    control plane's counter stays the one in the table (SPEC-0041 AC1).
//  - a state names its trend and which envelope behaviour follows
//    (SPEC-0046 AC2); the throttle observation shows the METERED desired
//    state and the APPLIED ack as two halves — absence renders as absence
//    (SPEC-0046 AC3). All of it arrives from the control plane: rendered,
//    never derived.
import type { UsageViewResponse } from '../lib/bff';

interface Props {
  view: UsageViewResponse;
}

const { view } = Astro.props;

// dimensionTitles maps the contract's dimension names onto reader prose; an
// unnamed dimension renders its raw name, never a guessed title.
const dimensionTitles: Record<string, string> = {
  SEATS: 'Seats',
  REPOSITORY_COUNT: 'Repositories',
  REPOSITORY_STORAGE: 'Repository storage',
  CI_MINUTES: 'CI job minutes',
  CI_CONCURRENCY: 'CI concurrency',
  SCAN_VOLUME: 'Scan volume',
  INDEX_SIZE: 'Code-search index size',
  EGRESS: 'Egress',
};

function dimensionTitle(name: string): string {
  return dimensionTitles[name] ?? name;
}

// Envelope state and trend come from the shared vocabulary (SPEC-0047 AC6):
// each state has its own glyph, each trend its own arrow, so neither reads by
// colour alone. The pins in usage-regression-pins.test.ts are untouched by
// this — the STATE WORD is still rendered, it now simply arrives with shape.
import { ENVELOPE_STATUS, TREND } from '../lib/status';

const stateStyles: Record<string, { color: string; background: string }> = {
  WITHIN: { color: 'var(--gf-info-ink)', background: 'var(--gf-diff-add-bg)' },
  NEAR: { color: 'var(--gf-warn-ink)', background: 'var(--gf-diff-del-bg)' },
  EXCEEDED: { color: 'var(--gf-danger-ink)', background: 'var(--gf-diff-del-bg)' },
};

// trendLabels renders the direction the control plane cites (SPEC-0046
// AC2); an absent trend renders nothing — a row without a number has no
// direction to show.
const trendLabels: Record<string, string> = {
  FLAT: 'flat',
  RISING: 'rising',
  FALLING: 'falling',
};

// envelopeBehaviour names which enforcement follows each state (SPEC-0046
// AC2): the notification is not the customer's first sight of trouble, and
// the prose states what the throttle vocabulary does — git untouched.
const envelopeBehaviour: Record<string, string> = {
  WITHIN: 'within its envelope; no enforcement',
  NEAR: 'approaching the envelope; warning notices fire, nothing is throttled yet',
  EXCEEDED: 'past the envelope; CI concurrency reduced and queued jobs delayed — git traffic untouched',
};

function formatNumber(value: number): string {
  return value.toLocaleString('en-US');
}

function formatWindow(start?: string, end?: string): string {
  if (!start || !end) return '';
  return `${new Date(start).toISOString().slice(0, 16)} → ${new Date(end).toISOString().slice(0, 16)} UTC`;
}
---

<section aria-label="Fair-use usage view">
  <p style={{ color: 'var(--gf-ink-muted)', fontSize: 13, margin: '12px 0' }}>
    Numbers are the control plane's own counters from telemetry it received —
    the same counters every fair-use decision is made from. Dimensions this
    phase does not meter say so; a silent data plane renders as a visible
    gap, never as zero usage.
  </p>

  <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 14 }}>
    <thead>
      <tr style={{ borderBottom: '1px solid var(--gf-line)', color: 'var(--gf-ink-muted)', textAlign: 'left' }}>
        <th style={{ padding: '8px 12px 8px 0' }}>Dimension</th>
        <th style={{ padding: '8px 12px' }}>Coverage</th>
        <th style={{ padding: '8px 12px' }}>Current</th>
        <th style={{ padding: '8px 12px' }}>Envelope</th>
        <th style={{ padding: '8px 12px' }}>Interval</th>
      </tr>
    </thead>
    <tbody>
      {view.dimensions.map((row) => {
        const style = row.state ? stateStyles[row.state] : undefined;
        return (
          <tr style={{ borderBottom: '1px solid var(--gf-line)' }} data-dimension={row.dimension} data-coverage={row.coverage} data-gap={row.telemetry_gap ? 'true' : undefined}>
            <td style={{ padding: '10px 12px 10px 0', fontWeight: 600 }}>
              {dimensionTitle(row.dimension)}
              {row.state && ENVELOPE_STATUS[row.state as keyof typeof ENVELOPE_STATUS] && (
                <span
                  class:list={['gf-status', ENVELOPE_STATUS[row.state as keyof typeof ENVELOPE_STATUS].tone]}
                  style={{ marginLeft: 8, fontSize: 12 }}
                >
                  {row.state}
                </span>
              )}
              {row.trend && TREND[row.trend as keyof typeof TREND] && (
                <span data-usage-trend style={{ marginLeft: 6, fontSize: 12, color: 'var(--gf-ink-muted)' }}>
                  <span aria-hidden="true">{TREND[row.trend as keyof typeof TREND].glyph}</span>
                  {' '}{TREND[row.trend as keyof typeof TREND].label}
                </span>
              )}
              {row.state && envelopeBehaviour[row.state] && (
                <div data-envelope-behaviour style={{ fontWeight: 400, fontSize: 12, color: 'var(--gf-ink-muted)', marginTop: 2 }}>
                  {envelopeBehaviour[row.state]}
                </div>
              )}
            </td>
            <td style={{ padding: '10px 12px', color: row.coverage === 'METERED' ? 'var(--gf-ink-muted)' : 'var(--gf-action-ink)' }}>
              {row.coverage === 'DEFERRED' ? 'Not metered yet' : row.telemetry_gap ? 'Telemetry gap' : 'Metered'}
            </td>
            <td style={{ padding: '10px 12px' }}>
              {row.coverage === 'DEFERRED' && <em>No measurement in this phase</em>}
              {row.coverage !== 'DEFERRED' && row.telemetry_gap && <em>No telemetry received</em>}
              {row.coverage === 'METERED' && !row.telemetry_gap && row.value !== undefined && (
                <span data-usage-value>
                  {formatNumber(row.value)}
                  {row.unit ? ` ${row.unit}` : ''}
                </span>
              )}
            </td>
            <td style={{ padding: '10px 12px', color: 'var(--gf-ink-muted)' }}>
              {row.coverage === 'METERED' && !row.telemetry_gap && row.envelope !== undefined && (
                <span>
                  {formatNumber(row.envelope)}
                  {row.unit ? ` ${row.unit}` : ''}
                  {row.notification !== undefined && <span style={{ fontSize: 12 }}> (notify at {formatNumber(row.notification)})</span>}
                </span>
              )}
            </td>
            <td style={{ padding: '10px 12px', color: 'var(--gf-ink-muted)', fontSize: 13 }}>
              {row.coverage === 'DEFERRED' && row.deferred_reason}
              {row.coverage !== 'DEFERRED' && !row.telemetry_gap && formatWindow(row.window_start, row.window_end)}
              {row.telemetry_gap &&
                row.gaps.map((gap) => (
                  <div>
                    {formatWindow(gap.window_start, gap.window_end)}: {gap.reason}
                  </div>
                ))}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>

  {view.divergences.length > 0 && (
    <section aria-labelledby="divergences-heading" style={{ marginTop: 24 }}>
      <h2 id="divergences-heading" style={{ fontSize: 16 }}>Health findings: reported vs counted</h2>
      <p style={{ color: 'var(--gf-ink-muted)', fontSize: 13 }}>
        A data plane's own report disagreed with the control plane's counter
        over an interval. Both numbers are shown; the control plane's counter
        above is unchanged — a divergence is a health finding, never a
        billing adjustment.
      </p>
      <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 14 }}>
        <thead>
          <tr style={{ borderBottom: '1px solid var(--gf-line)', color: 'var(--gf-ink-muted)', textAlign: 'left' }}>
            <th style={{ padding: '8px 12px 8px 0' }}>Dimension</th>
            <th style={{ padding: '8px 12px' }}>Data plane</th>
            <th style={{ padding: '8px 12px' }}>Control plane counted</th>
            <th style={{ padding: '8px 12px' }}>Reported by plane</th>
            <th style={{ padding: '8px 12px' }}>Interval</th>
          </tr>
        </thead>
        <tbody>
          {view.divergences.map((d) => (
            <tr style={{ borderBottom: '1px solid var(--gf-line)' }}>
              <td style={{ padding: '10px 12px 10px 0', fontWeight: 600 }}>{dimensionTitle(d.dimension)}</td>
              <td style={{ padding: '10px 12px' }}>{d.data_plane_id}</td>
              <td style={{ padding: '10px 12px' }}>{formatNumber(d.control_plane_value)}</td>
              <td style={{ padding: '10px 12px' }}>{formatNumber(d.data_plane_reported_value)}</td>
              <td style={{ padding: '10px 12px', color: 'var(--gf-ink-muted)', fontSize: 13 }}>{formatWindow(d.window_start, d.window_end)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {view.throttle && (
    <section aria-label="Envelope throttle observation" data-throttle-observation style={{ marginTop: 24 }}>
      <h2 style={{ fontSize: 16 }}>Envelope throttle: metered and applied</h2>
      <p style={{ color: 'var(--gf-ink-muted)', fontSize: 13 }}>
        What the control plane METERED as the desired state, and what your
        data plane acked as APPLIED — shown as two numbers, never smoothed
        into one. Git operations are never part of this throttle.
      </p>
      <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 14 }}>
        <thead>
          <tr style={{ borderBottom: '1px solid var(--gf-line)', color: 'var(--gf-ink-muted)', textAlign: 'left' }}>
            <th style={{ padding: '8px 12px 8px 0' }}>Generation</th>
            <th style={{ padding: '8px 12px' }}>Max CI concurrency</th>
            <th style={{ padding: '8px 12px' }}>Queue depth cap</th>
            <th style={{ padding: '8px 12px' }}>Applied by data plane</th>
          </tr>
        </thead>
        <tbody>
          <tr style={{ borderBottom: '1px solid var(--gf-line)' }}>
            <td style={{ padding: '10px 12px 10px 0' }}>{view.throttle.desired_generation}</td>
            <td style={{ padding: '10px 12px' }}>
              {view.throttle.desired_max_ci_concurrency > 0
                ? view.throttle.desired_max_ci_concurrency
                : 'unchanged (no throttle metered)'}
            </td>
            <td style={{ padding: '10px 12px' }}>
              {view.throttle.desired_queue_depth_cap > 0
                ? `${view.throttle.desired_queue_depth_cap} (queued jobs delayed, never dropped)`
                : 'unchanged (no throttle metered)'}
            </td>
            <td style={{ padding: '10px 12px' }}>
              {!view.throttle.has_applied_ack && <em data-throttle-unacked>No acknowledgement recorded yet</em>}
              {view.throttle.has_applied_ack && view.throttle.applied && (
                <span data-throttle-applied style={{ color: 'var(--gf-info-ink)' }}>
                  Applied{view.throttle.acked_at ? ` at ${new Date(view.throttle.acked_at).toISOString().slice(0, 16)} UTC` : ''}
                  {view.throttle.applied_generation !== undefined && ` (generation ${view.throttle.applied_generation})`}
                </span>
              )}
              {view.throttle.has_applied_ack && view.throttle.applied === false && (
                <span data-throttle-failed style={{ color: 'var(--gf-danger-ink)' }}>
                  Not applied{view.throttle.applied_error ? `: ${view.throttle.applied_error}` : ''}
                </span>
              )}
            </td>
          </tr>
        </tbody>
      </table>
    </section>
  )}

  <p style={{ color: 'var(--gf-ink-muted)', fontSize: 12, marginTop: 16 }}>
    Generated at {new Date(view.generated_at).toISOString().slice(0, 16)} UTC.
    Fair use is enforced by throttle and notice only — nothing here blocks
    your git traffic.
  </p>
</section>
