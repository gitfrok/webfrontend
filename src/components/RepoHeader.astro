---
// The header every repository surface shares (T-0046). It exists so the
// revision, the path and the actions sit in one place rather than being
// re-improvised per page — which is how the pre-ADR-0069 pages drifted apart.
interface Props {
  title: string;
  revision?: string;
  /** Optional right-hand affordance, e.g. the raw link on the file view. */
  actionHref?: string;
  actionLabel?: string;
}
const { title, revision, actionHref, actionLabel } = Astro.props;
---
<header
  style="display:flex; justify-content:space-between; align-items:baseline; gap:var(--gf-space-4); padding-bottom:var(--gf-space-3); margin-bottom:var(--gf-space-4); border-bottom:1px solid var(--gf-line);"
>
  <h1 style="font-size: var(--gf-text-xl); font-weight:600; margin:0; overflow-wrap:anywhere;">{title}</h1>
  <div style="display:flex; gap:var(--gf-space-4); align-items:baseline;">
    {revision && <code class="gf-muted gf-sha">{revision}</code>}
    {actionHref && actionLabel && <a href={actionHref}>{actionLabel}</a>}
  </div>
</header>
