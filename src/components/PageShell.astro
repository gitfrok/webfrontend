---
// The content column every page composes (T-0077, SPEC-0060 AC6/AC7, ADR-0079
// decision 3).
//
// Before this existed, each page declared its own geometry: seventeen surfaces
// carried three different content widths — 1080, 960 and 760 px — so the column
// jumped as a reader navigated, and each new surface picked whichever number the
// page beside it happened to use. A page now says what it IS — a title, and its
// content — and not how wide the product is.
//
// It does NOT replace Layout.astro. Layout owns the document, the nav, the skip
// link and the `main` landmark; this owns the column inside them. Merging the two
// would put nav geometry and page geometry in one component, and pages would start
// reaching into the nav.
//
// The heading is rendered here, once, because two `h1`s is the failure a shell
// most easily introduces: a page that keeps its own heading and composes one as
// well. AC7 tests for exactly that.
import { measureFor, type PageMeasure } from '../lib/shell';

interface Props {
  /** The page's heading. Rendered as the one `h1`. */
  title: string;
  /**
   * How wide the content is allowed to be. `prose` is the default and the answer
   * for almost everything; `wide` is for surfaces whose content is a table rather
   * than prose, where a narrower column costs a reader columns.
   *
   * It is a name and not a number, so a page cannot invent a fourth width — which
   * is how the three widths happened.
   */
  measure?: PageMeasure;
  /**
   * Optional prose under the heading. Present as a prop rather than a slot so the
   * spacing between heading and lede belongs to the shell rather than to whichever
   * page wrote it last.
   */
  lede?: string;
  /** Set when the page's own markup carries the heading (a repository header). */
  headingHidden?: boolean;
}

const { title, measure = 'prose', lede, headingHidden = false } = Astro.props as Props;
---

<div class="gf-page" style={{ maxWidth: measureFor(measure) }}>
  {headingHidden ? (
    // Some surfaces lead with a repository header that already names the thing —
    // rendering an h1 here as well would give the page two. The title still
    // travels, because it is what the document is called.
    <span class="gf-sr-only">{title}</span>
  ) : (
    <h1 class="gf-page-title">{title}</h1>
  )}
  {lede && <p class="gf-page-lede">{lede}</p>}
  <slot />
</div>
