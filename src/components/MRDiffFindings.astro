---
// MRDiffFindings renders one merge request's findings inline in its diff
// (T-0024, SPEC-0028 AC4): the patch is split per file, and each finding is
// annotated directly under the file its head-revision location resolves to,
// anchored by the finding's identity so a later push that shifts the line
// re-resolves the placement without breaking the anchor (SPEC-0024 identity
// stability). A finding whose head path matches no file in the diff stays
// reachable in a trailing section — never dropped.
//
// Presentational only: attribution and triage arrive from the backend and
// are rendered verbatim. A failed, timed-out, missing or not-yet-run scan
// renders as UNAVAILABLE with its reason — never as "no findings"
// (SPEC-0028 AC7).
import type { AttributionSummary, MRFindingView } from '../lib/bff';

interface Props {
  patch: string;
  findings: MRFindingView[];
  summary: AttributionSummary;
}

const { patch, findings, summary } = Astro.props;

// FileDiff is one file's slice of the patch with the path the diff writes it
// at — the +++ side when there is one, the --- side for a deletion.
interface FileDiff {
  path: string;
  body: string;
}

function splitPatch(patchText: string): FileDiff[] {
  const files: FileDiff[] = [];
  let current: FileDiff | null = null;
  for (const line of patchText.split('\n')) {
    if (line.startsWith('diff --git ')) {
      if (current) files.push(current);
      current = { path: '', body: `${line}\n` };
      continue;
    }
    if (!current) continue; // a preamble before the first file belongs to no file
    current.body += `${line}\n`;
    if (line.startsWith('+++ ')) {
      const target = line.slice(4).trim();
      if (target !== '/dev/null') current.path = target.startsWith('b/') ? target.slice(2) : target;
    } else if (line.startsWith('--- ') && current.path === '') {
      const source = line.slice(4).trim();
      if (source !== '/dev/null') current.path = source.startsWith('a/') ? source.slice(2) : source;
    }
  }
  if (current) files.push(current);
  return files;
}

const fileDiffs = splitPatch(patch);

// Placement is by the finding's identity through its head-revision location:
// a file shows the findings resolved to its path, and anything that resolves
// nowhere in this diff is still listed, so no attributed finding is dropped
// by a rename or a hunk the page does not carry.
const placed = new Set<string>();
function findingsFor(path: string): MRFindingView[] {
  return findings.filter((view) => {
    if (view.head_location.artifact_path !== path) return false;
    placed.add(view.finding.finding_id);
    return true;
  });
}
// Compute placement for every file before collecting the remainder.
const perFile = fileDiffs.map((file) => ({ file, annotations: findingsFor(file.path) }));
const unplaced = findings.filter((view) => !placed.has(view.finding.finding_id));

const unavailable = summary.status === 'UNAVAILABLE';
const computedEmpty = !unavailable && findings.length === 0;

const unavailableReasons: Record<string, string> = {
  BASE_NOT_SCANNED: 'the target branch has not been scanned at the merge base',
  HEAD_SCAN_FAILED: 'the scan of this merge request’s head revision failed',
  HEAD_SCAN_TIMED_OUT: 'the scan of this merge request’s head revision timed out',
  HEAD_SCAN_NOT_RUN: 'no scan of this merge request’s head revision has run yet',
  NO_MERGE_BASE: 'the source and target revisions share no merge base',
};

const severityStyles: Record<string, { color: string; background: string }> = {
  CRITICAL: { color: 'var(--gf-danger-ink)', background: 'var(--gf-diff-del-bg)' },
  HIGH: { color: 'var(--gf-warn-ink)', background: 'var(--gf-diff-del-bg)' },
  MEDIUM: { color: 'var(--gf-warn-ink)', background: 'var(--gf-diff-del-bg)' },
  LOW: { color: 'var(--gf-info-ink)', background: 'var(--gf-diff-add-bg)' },
};

const triageLabels: Record<string, string> = {
  ACCEPT: 'Accepted',
  FALSE_POSITIVE: 'False positive',
  FIX: 'Fix',
  DEFER: 'Deferred',
};

const attributionLabels: Record<string, string> = {
  ATTRIBUTED: 'Introduced by this MR',
  PRE_EXISTING: 'Pre-existing',
  UNAVAILABLE: 'Attribution unavailable',
};
---

{unavailable && (
  <div
    role="status"
    style={{ margin: '16px 0', padding: '12px 16px', border: '1px solid var(--gf-warn)', borderRadius: '8px', background: 'var(--gf-diff-del-bg)' }}
  >
    <p style={{ margin: '0px', fontWeight: 600, fontSize: '14px' }}>
      Attribution unavailable
      <code style={{ marginLeft: '8px', fontSize: '11px', fontWeight: 400, color: 'var(--gf-ink-muted)', background: 'var(--gf-surface)', padding: '1px 6px', borderRadius: '4px' }}>
        UNAVAILABLE
      </code>
    </p>
    <p style={{ margin: '6px 0 0', fontSize: '13px', color: 'var(--gf-warn-ink)' }}>
      {summary.unavailable_reason
        ? unavailableReasons[summary.unavailable_reason] ?? 'the comparison cannot be computed'
        : 'the comparison cannot be computed'}
      {summary.unavailable_reason && (
        <code style={{ marginLeft: '6px', fontSize: '11px', color: 'var(--gf-ink-muted)', background: 'var(--gf-surface)', padding: '1px 6px', borderRadius: '4px' }}>
          {summary.unavailable_reason}
        </code>
      )}
    </p>
  </div>
)}

{computedEmpty && (
  <p style={{ margin: '16px 0', fontSize: '13px', color: 'var(--gf-ink-muted)' }}>No findings introduced by this merge request.</p>
)}

{perFile.map(({ file, annotations }) => (
  <div style={{ margin: '16px 0' }}>
    <pre
      style={{
        whiteSpace: 'pre-wrap',
        wordBreak: 'break-all',
        background: 'var(--gf-soft)',
        padding: '16px',
        borderRadius: '8px',
        overflowX: 'auto',
        fontSize: '13px',
        lineHeight: 1.5,
        margin: '0px',
      }}
    >
      {file.body}
    </pre>
    {annotations.map((view) => {
      const severityStyle = severityStyles[view.finding.severity] ?? { color: 'var(--gf-ink)', background: 'var(--gf-line)' };
      const triageLabel = view.triage ? triageLabels[view.triage.state] ?? view.triage.state : '';
      return (
        <div
          id={`finding-${view.finding.finding_id}`}
          style={{
            margin: '8px 0 0 24px',
            padding: '10px 14px',
            borderLeft: '3px solid var(--gf-danger-ink)',
            background: 'var(--gf-diff-del-bg)',
            borderRadius: '0 6px 6px 0',
            fontSize: '13px',
          }}
        >
          <div style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: '8px' }}>
            <span
              style={{
                fontWeight: 600,
                fontSize: '12px',
                padding: '1px 8px',
                borderRadius: '999px',
                color: severityStyle.color,
                background: severityStyle.background,
              }}
            >
              {view.finding.severity}
            </span>
            <span style={{ fontWeight: 600 }}>{view.finding.rule_id}</span>
            <span style={{ color: 'var(--gf-ink-muted)' }}>{view.finding.scanner_class}</span>
            <span style={{ color: 'var(--gf-ink-muted)', fontSize: '12px' }}>
              {attributionLabels[view.attribution] ?? 'Attribution unavailable'}
            </span>
            <span
              style={{
                marginLeft: 'auto',
                fontSize: '12px',
                fontWeight: view.triage ? 600 : 400,
                color: view.triage ? 'var(--gf-info-ink)' : 'var(--gf-ink-muted)',
              }}
            >
              {triageLabel || 'Awaiting triage'}
            </span>
          </div>
          {view.head_location.enclosing_content && (
            <p style={{ margin: '6px 0 0', color: 'var(--gf-ink-muted)' }}>
              in <code style={{ fontSize: '12px' }}>{view.head_location.enclosing_content}</code>
            </p>
          )}
          {view.triage && view.triage.justification && (
            <p style={{ margin: '4px 0 0', fontSize: '12px', color: 'var(--gf-ink-muted)', fontStyle: 'italic' }}>
              Triage ({triageLabel}): “{view.triage.justification}”
            </p>
          )}
        </div>
      );
    })}
  </div>
))}

{unplaced.length > 0 && (
  <section aria-label="Findings elsewhere in this merge request" style={{ margin: '24px 0' }}>
    <h2 style={{ fontSize: '14px', margin: '0 0 8px' }}>Findings elsewhere in this merge request</h2>
    {unplaced.map((view) => {
      const severityStyle = severityStyles[view.finding.severity] ?? { color: 'var(--gf-ink)', background: 'var(--gf-line)' };
      const triageLabel = view.triage ? triageLabels[view.triage.state] ?? view.triage.state : '';
      return (
        <div
          id={`finding-${view.finding.finding_id}`}
          style={{
            margin: '8px 0',
            padding: '10px 14px',
            borderLeft: '3px solid var(--gf-danger-ink)',
            background: 'var(--gf-diff-del-bg)',
            borderRadius: '0 6px 6px 0',
            fontSize: '13px',
          }}
        >
          <div style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: '8px' }}>
            <span
              style={{
                fontWeight: 600,
                fontSize: '12px',
                padding: '1px 8px',
                borderRadius: '999px',
                color: severityStyle.color,
                background: severityStyle.background,
              }}
            >
              {view.finding.severity}
            </span>
            <span style={{ fontWeight: 600 }}>{view.finding.rule_id}</span>
            <code style={{ fontSize: '12px', color: 'var(--gf-ink-muted)' }}>{view.head_location.artifact_path}</code>
            <span
              style={{
                marginLeft: 'auto',
                fontSize: '12px',
                fontWeight: view.triage ? 600 : 400,
                color: view.triage ? 'var(--gf-info-ink)' : 'var(--gf-ink-muted)',
              }}
            >
              {triageLabel || 'Awaiting triage'}
            </span>
          </div>
        </div>
      );
    })}
  </section>
)}
