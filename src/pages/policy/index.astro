---
// Policy visibility (T-0063, SPEC-0055; PRD PR-16's read half).
//
// PR-16 asks for policy authored, versioned, dry-run and enforced. Three of
// those exist and one of them was invisible until now: every decision already
// records the bundle revision that made it. This page shows that.
//
// Authoring is absent, and the page says where it happens instead. It does NOT
// show a disabled form, a "coming soon" or an "ask your administrator": each
// tells the reader they are one permission away from something, and they are
// not — ADR-0073 defers deciding what a tenant-authored policy even is.
import Layout from '../../layouts/Layout.astro';
import { policyBundle, policyDecision } from '../../lib/bff';
import type { BundleStatusView, DecisionRecordView } from '../../lib/bff';
import { POLICY_MESSAGES, modeLabel } from '../../lib/policy';
import { describeStatus } from '../../lib/status';

const decisionID = Astro.url.searchParams.get('decision_id') ?? '';

let bundle: BundleStatusView | null = null;
let bundleError = false;
try {
  bundle = await policyBundle(Astro.request);
} catch {
  bundleError = true;
}

let decision: DecisionRecordView | null = null;
let decisionError = false;
if (decisionID) {
  try {
    decision = await policyDecision(Astro.request, decisionID);
  } catch {
    decisionError = true;
  }
}

const outcome = decision ? describeStatus(decision.allowed ? 'ALLOWED' : 'DENIED') : null;
const day = (iso: string) => (iso ? iso.slice(0, 19).replace('T', ' ') : '');
---

<Layout title="Policy">
  <div style={{ maxWidth: '960px', margin: '0 auto', padding: '0 var(--gf-space-4)' }}>
    <h1 style={{ fontSize: '22px', margin: 'var(--gf-space-4) 0 var(--gf-space-2)' }}>Policy</h1>

    <p class="gf-note" style={{ borderLeftColor: 'var(--gf-info-ink)' }}>
      {POLICY_MESSAGES.authoredInGovernance}
    </p>

    <section class="gf-card" aria-labelledby="bundle-heading" style={{ margin: 'var(--gf-space-4) 0' }}>
      <h2 id="bundle-heading" style={{ fontSize: '16px', margin: '0 0 var(--gf-space-2)' }}>In force</h2>
      {bundleError ? (
        <p style={{ margin: '0px', display: 'flex', alignItems: 'center', gap: 'var(--gf-space-2)' }}>
          <span class="gf-status gf-status-warn" style={{ fontSize: '13px' }}>Unavailable</span>
          <span>{POLICY_MESSAGES.bundleUnavailable}</span>
        </p>
      ) : bundle && bundle.bundle_revision ? (
        <p class="gf-muted" style={{ margin: '0px', fontSize: '13px' }}>
          Bundle revision <span style={{ fontFamily: 'var(--gf-font-code)' }}>{bundle.bundle_revision}</span>
          {bundle.loaded_at && <> · loaded {day(bundle.loaded_at)}</>}
        </p>
      ) : (
        <p class="gf-muted" style={{ margin: '0px', fontSize: '13px' }}>{POLICY_MESSAGES.noRevision}</p>
      )}
    </section>

    <section aria-labelledby="decision-heading">
      <h2 id="decision-heading" style={{ fontSize: '16px', margin: 'var(--gf-space-6) 0 var(--gf-space-2)' }}>
        Look up a decision
      </h2>
      <p class="gf-muted" style={{ fontSize: '13px', margin: '0 0 var(--gf-space-3)' }}>
        Every decision records the bundle revision that made it. Paste a decision id to see which.
      </p>

      <form method="get" style={{ marginBottom: 'var(--gf-space-4)' }}>
        <label class="gf-field">
          <span>Decision id</span>
          <input class="gf-input" type="text" name="decision_id" value={decisionID} />
        </label>
        <button type="submit" class="gf-btn">Look up</button>
      </form>

      {decisionError && (
        <p class="gf-note" role="status" style={{ borderLeftColor: 'var(--gf-warn-ink)' }}>
          <span class="gf-status gf-status-warn" style={{ fontSize: '13px' }}>Unavailable</span>
          {' '}{POLICY_MESSAGES.decisionUnavailable}
        </p>
      )}

      {decision && outcome && (
        <div class="gf-card">
          <p style={{ margin: '0 0 var(--gf-space-3)', display: 'flex', alignItems: 'center', gap: 'var(--gf-space-3)', flexWrap: 'wrap' }}>
            <span class:list={['gf-status', outcome.tone]} style={{ fontSize: '13px' }}>
              {outcome.descriptor.label}
            </span>
            <strong style={{ fontSize: '14px' }}>{decision.action}</strong>
            <span class="gf-muted" style={{ fontSize: '13px' }}>
              {decision.resource_type} {decision.resource_id}
            </span>
          </p>
          <dl style={{ display: 'grid', gridTemplateColumns: 'auto 1fr', gap: 'var(--gf-space-1) var(--gf-space-3)', fontSize: '13px', margin: '0px' }}>
            <dt class="gf-muted">Decided by revision</dt>
            <dd style={{ margin: '0px', fontFamily: 'var(--gf-font-code)' }}>{decision.policy_revision}</dd>

            <dt class="gf-muted">Mode</dt>
            <dd style={{ margin: '0px' }}>{modeLabel(decision.mode)}</dd>

            <dt class="gf-muted">Input digest</dt>
            <dd style={{ margin: '0px', fontFamily: 'var(--gf-font-code)' }}>{decision.input_digest}</dd>

            <dt class="gf-muted">Decided at</dt>
            <dd style={{ margin: '0px' }}>{day(decision.decided_at)}</dd>
          </dl>
        </div>
      )}
    </section>
  </div>
</Layout>
