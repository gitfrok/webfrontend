---
// The landing page (T-0055, SPEC-0052; PRD PR-24).
//
// This was the T-0001 scaffolding stub from Phase 0 until now, and it stayed
// one for a reason that outlived the scaffolding: no route could answer what
// belongs here. The Repository context had no durable registry to list from —
// its only store was a map that emptied on restart — so the question "which
// repositories exist" had no answer the product could stand behind
// (ADR-0071).
import Layout from '../layouts/Layout.astro';
import RepositoryList from '../components/RepositoryList.astro';
import { listRepositories } from '../lib/bff';
import type { RepositoryListView } from '../lib/bff';
import { REPOSITORY_MESSAGES } from '../lib/repositories';

const pageToken = Astro.url.searchParams.get('page_token') ?? '';

let page: RepositoryListView | null = null;
let loadError = false;
try {
  page = await listRepositories(Astro.request, pageToken);
} catch {
  loadError = true;
}
---

<Layout title="gitfrok">
  <div style={{ maxWidth: '960px', margin: '0 auto', padding: '0 var(--gf-space-4)' }}>
    <h1 style={{ fontSize: '22px', margin: 'var(--gf-space-4) 0 var(--gf-space-2)' }}>Repositories</h1>
    <p class="gf-muted" style={{ fontSize: '14px', margin: '0 0 var(--gf-space-4)' }}>
      What your access covers, decided by the server when you loaded this page.
    </p>

    {loadError ? (
      <p class="gf-note" role="status" style={{ borderLeftColor: 'var(--gf-warn-ink)' }}>
        <span class="gf-status gf-status-warn" style={{ fontSize: '13px' }}>Unavailable</span>
        {' '}{REPOSITORY_MESSAGES.unavailable}
      </p>
    ) : (
      page && <RepositoryList repositories={page.repositories} nextPageToken={page.next_page_token} />
    )}
  </div>
</Layout>
