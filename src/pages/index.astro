---
// Baseline landing page. Proves the Astro SSR shell builds (T-0001 AC3).
// Real repo/file/diff views arrive in T-0015; they call the BFF only.
import Layout from '../layouts/Layout.astro';

const app = 'gitfrok';
---

<Layout title={app}>
  <main style={{ maxWidth: '1080px', margin: '0 auto', padding: '16px' }}>
    <h1 style={{ fontSize: '24px', margin: '16px 0 8px' }}>{app}</h1>
    <p style={{ color: 'var(--gf-ink-muted)', fontSize: '14px', margin: '0px' }}>
      webfrontend baseline — SSR shell wired (ADR-0015).
    </p>
  </main>
</Layout>
