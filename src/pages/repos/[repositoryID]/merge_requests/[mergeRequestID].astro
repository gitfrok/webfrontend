---
// Minimal merge-request view (T-0016 web bar; plan risk note: "minimal MR page
// is sufficient"). Served via SSR from the BFF only (invariant 22). It renders
// the review state and links to the diff between the source and target refs;
// it never renders a policy outcome, approval count, or authorization result.
// When an import_id is present it also renders that import's declared history in
// its own labelled section (SPEC-0011 AC23): imported review never mixes into
// the first-party review above it, and an imported approval never reads as a
// platform approval.
import { mergeRequest, importedHistory } from '../../../../lib/bff';
import Layout from '../../../../layouts/Layout.astro';
import CommandPalette from '../../../../components/CommandPalette';
import ImportedHistory from '../../../../components/ImportedHistory.astro';
import type { ImportedMergeRequestView } from '../../../../lib/provenance';

const { repositoryID, mergeRequestID } = Astro.params;
let mr: Awaited<ReturnType<typeof mergeRequest>> | null = null;
let loadError = false;

try {
  mr = await mergeRequest(Astro.request, repositoryID!, mergeRequestID!);
} catch {
  loadError = true;
}

// The import to show, if any. A failed history read is reported rather than
// rendered as an empty section: "this import declared nothing" and "we could not
// read what it declared" are different facts, and only one of them is true.
const importID = Astro.url.searchParams.get('import_id') ?? '';
let imported: ImportedMergeRequestView[] = [];
let importedError = false;
if (importID) {
  try {
    imported = (await importedHistory(Astro.request, repositoryID!, importID)).merge_requests;
  } catch {
    importedError = true;
  }
}

const diffHref = mr
  ? `/repos/${repositoryID}/diff/${encodeURIComponent(mr.head_revision)}?base_revision=${encodeURIComponent(mr.source_ref)}`
  : '#';
---

<Layout title={mr ? `${mr.title} · ${repositoryID}` : `${repositoryID} MR`}>
  <CommandPalette client:load repositoryID={repositoryID!} revision="main" />
  <main style={{ maxWidth: 960, margin: '0 auto', padding: '0 16px' }}>
    {loadError && (
      <p style={{ color: '#cf222e' }}>This merge request is unavailable. Check your session.</p>
    )}

    {mr && (
      <>
        <header style={{ padding: '16px 0', borderBottom: '1px solid #d0d7de' }}>
          <h1 style={{ fontSize: 20, margin: 0 }}>{mr.title}</h1>
          <p style={{ color: '#57606a', margin: '8px 0 0', fontSize: 14 }}>
            {mr.state} · {mr.source_ref} → {mr.target_ref}
          </p>
        </header>

        {mr.description && <p style={{ margin: '16px 0' }}>{mr.description}</p>}

        <div style={{ display: 'flex', gap: 12, margin: '16px 0' }}>
          <a href={diffHref} style={{ color: '#0969da', textDecoration: 'none', fontSize: 14 }}>
            View diff
          </a>
        </div>

        <p style={{ color: '#6e7781', fontSize: 13 }}>
          Head revision {mr.head_revision.slice(0, 8)} · opened by {mr.creator_id} · version {mr.version}
        </p>
      </>
    )}

    {importedError && (
      <p style={{ color: '#cf222e' }}>
        This import's declared history could not be read. It is not shown, and this is not a
        statement that the import declared none.
      </p>
    )}
    <ImportedHistory records={imported} />
  </main>
</Layout>
