---
// Diff view (T-0015, SPEC-0008 AC1): stream the Git patch between a revision
// and its base, served via SSR from the BFF only. The base revision is the
// parent when omitted; the page reads base_revision from the query if given.
//
// When the diff is reviewed under a merge request (merge_request_id query
// parameter, linked from the MR page), the findings that MR introduced render
// inline at their locations in the patch (T-0024, SPEC-0028 AC4). The MR
// travels as its opaque identity only; a failed findings read is one coarse
// note — missing and unauthorized render identically (SPEC-0001) — and a
// failed, timed-out or missing scan is UNAVAILABLE with its reason, never
// "no findings" (SPEC-0028 AC7).
import { diff, mergeRequestFindings } from '../../../../lib/bff';
import type { MRFindingsPage } from '../../../../lib/bff';
import Layout from '../../../../layouts/Layout.astro';
import CommandPalette from '../../../../components/CommandPalette';
import MRDiffFindings from '../../../../components/MRDiffFindings.astro';
import DiffView from '../../../../components/DiffView.astro';
import RepoHeader from '../../../../components/RepoHeader.astro';

const { repositoryID, revision } = Astro.params;
const baseRevision = Astro.url.searchParams.get('base_revision') ?? `${revision}^`;
const mergeRequestID = Astro.url.searchParams.get('merge_request_id') ?? '';
let patch = '';
let loadError = false;

if (revision) {
  try {
    patch = await diff(Astro.request, repositoryID!, baseRevision, revision);
  } catch {
    loadError = true;
  }
}

// The MR's findings, keyed by the opaque MR identity alone. Any refusal —
// missing, malformed or unauthorized — is one coarse note below; the page
// distinguishes nothing about why the read failed.
let mrFindingsPage: MRFindingsPage | null = null;
let findingsError = false;
if (mergeRequestID) {
  try {
    mrFindingsPage = await mergeRequestFindings(Astro.request, mergeRequestID, {}, 0);
  } catch {
    findingsError = true;
  }
}
---

<Layout title={`diff ${baseRevision}..${revision}`}>
  <CommandPalette client:load repositoryID={repositoryID!} revision={revision!} />
  <RepoHeader title={repositoryID!} revision={`${baseRevision}..${revision}`} />

  {loadError && (
    <p class="gf-status gf-status-danger">This diff is unavailable. Check your session or the revisions.</p>
  )}

  {!loadError && mergeRequestID === '' && <DiffView patch={patch} />}

  {!loadError && mergeRequestID !== '' && findingsError && (
    <p class="gf-status gf-status-danger" style="margin:var(--gf-space-4) 0;">
      The findings for this merge request are unavailable.
    </p>
  )}

  {!loadError && mrFindingsPage && (
    <MRDiffFindings patch={patch} findings={mrFindingsPage.findings} summary={mrFindingsPage.summary} />
  )}
</Layout>
