---
// Raw file proxy (T-0015): stream the BFF's file bytes straight through. The
// SSR layer stays a thin proxy — it forwards the session cookie and copies the
// streamed bytes with the BFF's private/uncacheable semantics.
import { bffOrigin } from '../../../../../lib/bff';

const { repositoryID, revision } = Astro.params;
const pathParts = Astro.params.path ?? [];
const filePath = Array.isArray(pathParts) ? pathParts.join('/') : pathParts;

const url = new URL(`/v1/repositories/${encodeURIComponent(repositoryID!)}/file`, bffOrigin);
url.searchParams.set('revision', revision!);
url.searchParams.set('path', filePath);
const headers = new Headers();
const cookie = Astro.request.headers.get('cookie');
if (cookie) headers.set('cookie', cookie);

const response = await fetch(url, { headers, redirect: 'manual' });
const body = await response.arrayBuffer();

if (!response.ok) {
  return Astro.redirect('/');
}
const metadataHeader = response.headers.get('x-gitfrok-file-metadata');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{filePath}</title>
  </head>
  <body style="margin:0">
    <pre style="white-space:pre-wrap; word-break:break-all; background:#f6f8fa; padding:16px; margin:0; font-size:13px; line-height:1.5; min-height:100vh">{new TextDecoder().decode(new Uint8Array(body))}</pre>
  </body>
</html>
