---
// Shared SSR shell (ADR-0015 GitHub-clean). Thin proxy: no business logic,
// no data fetching beyond what the page itself does through the BFF.
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body style="margin:0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:#fff; color:#1f2328;">
    <slot />
  </body>
</html>
